{
  "name": "@versa/v-voice",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "cli": "node bin/v-voice.mjs",
    "test:cli": "node --test tests/voice-cli.test.mjs",
    "demo:cli": "node scripts/voice-cli-demo.mjs",
    "package:cli": "node scripts/package-cli.mjs",
    "lab:volc-speaker-auto": "node lab/volc-speaker-auto/server.mjs",
    "test:volc-speaker-auto": "node --test lab/volc-speaker-auto/*.test.mjs",
    "lab:volc-speaker": "node lab/volc-speaker/server.mjs",
    "test:volc-speaker": "node --test lab/volc-speaker/decision.test.mjs",
    "start": "node lab/gpt-live-h5/server.mjs",
    "preview": "GPT_LIVE_H5_PREVIEW=1 node lab/gpt-live-h5/server.mjs",
    "test": "node --test lab/gpt-live-h5/*.test.mjs lab/realtime-direct-tools/*.test.mjs lab/seeduplex-realtime-provider.test.mjs lab/robot/*.test.mjs tests/*.test.mjs plugins/*/*.test.mjs",
    "package": "node scripts/package.mjs",
    "start:speaker-native": "node --dns-result-order=ipv4first lab/speaker-native/server.mjs",
    "start:speaker-stream": "node --dns-result-order=ipv4first lab/speaker-native/stream-server.mjs",
    "test:speaker-native": "node --test lab/speaker-native/*.test.mjs",
    "build:ui": "node scripts/build-ui.mjs && node scripts/build-browser.mjs && node ios/scripts/sync-h5-shell.mjs",
    "build:ios-shell": "node ios/scripts/sync-h5-shell.mjs",
    "check:ios-shell": "node ios/scripts/sync-h5-shell.mjs --check",
    "phone": "node scripts/phone.mjs",
    "release:fleet": "python3 scripts/release-fleet.py",
    "build:tv": "node scripts/build-tv-entry.mjs"
  },
  "dependencies": {
    "opusscript": "0.1.1",
    "ws": "8.18.3"
  },
  "devDependencies": {
    "esbuild": "0.25.10",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  }
}
